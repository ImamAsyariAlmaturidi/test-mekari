{
  "name": "mini-inference-router",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace=@router/api",
    "dev:web": "npm run dev --workspace=@router/web",
    "build": "npm run build --workspaces",
